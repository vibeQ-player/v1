# Copy to .env.docker. Supply your own Spotify app credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
HOST_PASSWORD=
SESSION_SECRET=
ENABLE_ARCHIVES=true
ENABLE_ARTWORK=false
ENABLE_TRIVIA=false
ENABLE_BROWSER_PLAYER=false
