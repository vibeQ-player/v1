# Local mode needs Node.js only. Azure tools are not required.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Change both before running. Generate secrets with the README command.
HOST_PASSWORD=
SESSION_SECRET=
STORAGE_DRIVER=sqlite
DATA_DIR=./data
ENABLE_ARCHIVES=true
ENABLE_ARTWORK=false
ENABLE_TRIVIA=false
# Optional AI: an OpenAI-compatible API base, ending in /v1.
# Azure example: https://YOUR-RESOURCE.openai.azure.com/openai/v1
AI_BASE_URL=
AI_API_KEY=
AI_AUTH_HEADER=api-key
AI_IMAGE_MODEL=
AI_TRIVIA_MODEL=
AI_TRIVIA_FORMAT_MODEL=
# Use web_search_preview to match the original vibeQ pipeline, where supported.
AI_TRIVIA_SEARCH_TOOL=web_search
# Trivia requires a Responses API model with web search support.
# Optional limit: maximum processed tracks per day (UTC), or unlimited.
ADDON_DAILY_LIMIT=10
# Browser audio optional; otherwise playback uses a Spotify Connect device.
ENABLE_BROWSER_PLAYER=false
# Cloud settings are supplied by scripts/deploy.ps1; not needed locally.
# Optional: an already-validated custom domain for cloud frontend/CORS.
# PUBLIC_SITE_ORIGIN=https://vibeq.example.com
# COSMOS_ENDPOINT=
# COSMOS_KEY=
# COSMOS_DATABASE=vibeq
# ARTWORK_STORAGE_CONNECTION_STRING=
